# Production env vars (Render). Set these in the service's Environment tab.
# Do not commit the filled-in values.

# Comma-separated, no spaces. Must include your Cloudflare Workers domain.
# Required: main.py reads this with os.environ[...], so the app fails to
# boot if it is unset.
CORS_ORIGINS=https://wttin-web.<your-subdomain>.workers.dev

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Full service account JSON as a single value.
# JSON_KEY_PATH does not work here: there is no file to point at.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEET_ID=your-sheet-id

# Read implicitly by OpenCageGeocode(); the constructor raises ValueError if unset.
OPENCAGE_API_KEY=your-opencage-key

VENDOR_TEMP_PASSWORD=your-temp-password

# Discontinued: chatbot no longer in project scope
OPENAI_API_KEY=sk-...
