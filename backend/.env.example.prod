# Production env vars (Railway). Set these in the Railway service Variables tab.
# Do not commit the filled-in values.

# Comma-separated, no spaces. Must include your Cloudflare Pages domain.
# Add preview domains too if you want preview builds to reach the API.
CORS_ORIGINS=https://your-project.pages.dev

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Full service account JSON as a single value (use Railway's raw editor).
# Requires switching utils.py to Credentials.from_service_account_info().
# JSON_KEY_PATH does not work here: there is no file to point at.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEET_ID=your-sheet-id

VENDOR_TEMP_PASSWORD=your-temp-password

# Discontinued: chatbot no longer in project scope
OPENAI_API_KEY=sk-...
